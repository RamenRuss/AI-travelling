# Скопируйте в .env и впишите свои ключи. Файл .env в git НЕ коммитится.
# Ключи можно не хранить в файле, а задавать в окне терминала (переменные окружения важнее .env):
#   Windows (cmd):  set SPIRIT_API_KEY=ваш_ключ
#   Linux/macOS:    export SPIRIT_API_KEY=ваш_ключ

# real (по умолчанию) — настоящий агент: модель + инструменты (нужен SPIRIT_API_KEY)
# mock — заготовленные ответы для тестов, без ключей и интернета
# custom — ваш агент (см. AGENT ниже)
AGENT_MODE=real

SPIRIT_API_KEY=
# Необязательно: без этих ключей места ищет OpenStreetMap, маршруты строит OSRM (только авто)
GOOGLE_PLACES_API_KEY=
ORS_API_KEY=

# Необязательно: сменить модель или адрес прокси
# AGENT_MODEL=openrouter/deepseek/deepseek-v4.1-flash

# Свой агент: AGENT_MODE=custom и AGENT=пакет.модуль:функция (см. docs/ADD_AGENT.md)
# AGENT=my_agent.main:respond

# Отключить инструменты (через запятую)
# DISABLED_TOOLS=find_fuel,find_lodging

# --- Безопасность и лимиты (значения по умолчанию подходят для локального запуска) ---
# За HTTPS (хостинг, nginx): COOKIE_SECURE=1 — cookie уходит только по HTTPS, включается HSTS
# COOKIE_SECURE=1
# Если сервер стоит ЗА своим nginx/прокси и тот передаёт X-Forwarded-For: TRUST_PROXY=1 (иначе оставьте 0!)
# TRUST_PROXY=1
# /docs и /openapi.json — только для разработки
# DEBUG=1
# Лимиты запросов к модели на пользователя (защита от лишних трат)
# CHAT_PER_MINUTE=10
# CHAT_PER_DAY=300
# Где хранить базу (лучше вне папки проекта и вне общих/облачных папок)
# BUKHTA_DB=C:\bukhta-data\bukhta.db

# Необязательно: свои зеркала Overpass через запятую (по умолчанию — 4 публичных, опрашиваются параллельно)
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Потолок длины ответа модели в токенах
# MAX_OUTPUT_TOKENS=6000
